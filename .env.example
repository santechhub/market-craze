FINNHUB_API_KEY=
# Free key: https://site.financialmodelingprep.com/register  (1-year prices, company description, cash)
FMP_API_KEY=
# https://console.anthropic.com/  (6-12 month outlook and Buy/Hold/Sell signal)
ANTHROPIC_API_KEY=
# India (NSE) prices and 1-year history. Free with an Upstox account:
# developer.upstox.com -> create an app -> generate an access token.
# Prefer the long-lived read-only "Analytics Token" if your account offers it;
# a normal access token expires daily.
UPSTOX_ACCESS_TOKEN=
